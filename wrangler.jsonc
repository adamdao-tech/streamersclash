{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "streamersclash",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request goes through the Worker first so pages can be gated behind login.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "streamersclash",
      "database_id": "2e9b8b77-93a5-49a9-ae2f-628c85894f26"
    }
  ],
  "vars": {
    "TWITCH_CLIENT_ID": "jfq4y3dpmayp3srqtylgpjtz7hn9oa",
    // Superadmins (Twitch logins, comma-separated): the only ones who see the activity log.
    "SUPERADMINS": "ddddddao",
    // Streamers Queue API (Candi). Klíč je secret SQ_API_KEY – nikdy ho nedávej sem!
    "SQ_BASE_URL": "https://sq.candycz01.xyz"
  },
  // TWITCH_CLIENT_SECRET is a secret: set it in the Cloudflare dashboard
  // (Worker → Settings → Variables and Secrets) or in .dev.vars locally.
  // VOD sync: every 10 minutes, a batch of channels at a time.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
