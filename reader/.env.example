# Copy to .env and fill in. Never commit .env.
APP_URL=https://sc.daotech.dev
# Same value as the READER_TOKEN secret in Cloudflare. Generate with: openssl rand -hex 32
READER_TOKEN=

# Seconds between scanned frames. With SCAN_KEYFRAMES every keyframe (~2 s) is decoded anyway,
# so 2 costs about the same as 5 and catches post-game screens that are shown only briefly
SAMPLE_SECONDS=2
# How often to ask the app for new VODs
POLL_SECONDS=300
# Save confidently read drafts right away; otherwise everything waits for review
AUTO_ACCEPT=true
LOG_LEVEL=INFO
# how many VODs are read at the same time (each takes ~1 CPU core and some bandwidth)
WORKERS=3
# decode only keyframes while scanning (~10x faster); false = every frame
SCAN_KEYFRAMES=true
# lowest stream quality used for scanning: 150 = 160p (default); 360 finds small or briefly shown
# post-game screens more reliably, at ~2-3x the download per VOD
#SCAN_MIN_HEIGHT=360
