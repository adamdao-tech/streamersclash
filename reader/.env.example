# Copy to .env and fill in. Never commit .env.
APP_URL=https://sc.daotech.dev
# Same value as the READER_TOKEN secret in Cloudflare. Generate with: openssl rand -hex 32
READER_TOKEN=

# Seconds between scanned frames (lower = slower but catches short champ selects)
SAMPLE_SECONDS=5
# How often to ask the app for new VODs
POLL_SECONDS=300
# Save confidently read drafts right away; otherwise everything waits for review
AUTO_ACCEPT=true
LOG_LEVEL=INFO
